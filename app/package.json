{
  "name": "fourward-multiplayer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A server-authoritative, cross-device Connect Four game by Yitong Wu.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "test": "node --test test/*.test.js",
    "build": "node scripts/build.mjs",
    "validate": "node scripts/validate-artifact.mjs",
    "check": "npm test && npm run build && npm run validate"
  },
  "dependencies": {
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "socket.io-client": "^4.8.1"
  }
}
